rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@makeflow.tech';
    }
    function signedIn() {
      return request.auth != null;
    }

    // Student profile: the student can read only their own, admin can do everything.
    match /students/{username} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email == username + '@makeflow.tech');
      allow write: if isAdmin();
    }

    match /courses/{id}             { allow read: if signedIn(); allow write: if isAdmin(); }
    match /videos/{id}              { allow read: if signedIn(); allow write: if isAdmin(); }
    match /shared_files/{id}        { allow read: if signedIn(); allow write: if isAdmin(); }
    match /student_certificates/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /student_admin_notes/{id} { allow read, write: if isAdmin(); }
  }
}
